# Maintainer: Krxoid

pkgname=rock-core
pkgver=1.2.0
pkgrel=1
pkgdesc='Command-line manager for Minecraft Bedrock Dedicated Server instances'
arch=('any')
url='https://github.com/krxoid/rock-core'
license=('GPL-3.0-or-later')
depends=('java-runtime')

source=(
    "rock-core-${pkgver}.jar::https://github.com/krxoid/rock-core/releases/download/${pkgver}/rock-core-${pkgver}.jar"
    'rock'
)

sha256sums=(
    'a95b2ce7e3c301a7f5860087ec35c7fedf0a13c733530abba2ee96864aa355a4'
    'f282147acd9bf86e091b4b8a5d9b64ddd1c22a9890f0ddb27fc35509b2cd2159'
)

package() {
    install -Dm755 "$srcdir/rock" \
        "$pkgdir/usr/bin/rock"

    install -Dm644 "$srcdir/rock-core-${pkgver}.jar" \
        "$pkgdir/usr/share/rock-core/rock-core.jar"
}
